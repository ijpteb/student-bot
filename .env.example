# Файл настроек бота. Обычно нужно вписать только BOT_TOKEN (и потом ADMIN_ID).
# Здесь хранятся секреты: никому этот файл не отправляйте, в git он не попадает.

# Токен бота от @BotFather (выглядит как 1234567890:AAH...)
BOT_TOKEN=

# Ваш Telegram ID — только вам будут доступны служебные команды (/stats)
# и сообщения об ошибках. Узнать ID: напишите боту /id.
ADMIN_ID=

# Пароль базы данных. Придумывать не нужно: «Запустить бота.command» сам впишет
# случайный пароль, если строка пустая.
POSTGRES_PASSWORD=

# Адрес сервера Telegram Bot API. Менять, только если стандартный недоступен с вашего сервера.
TELEGRAM_API_URL=https://api.telegram.org
# Необязательный прокси для связи с Telegram (например, socks5://user:pass@host:port).
TELEGRAM_PROXY=

# Часовой пояс новых пользователей по умолчанию (код вида Europe/Moscow, Asia/Yekaterinburg)
DEFAULT_TIMEZONE=Europe/Moscow
