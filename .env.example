# Файл настроек бота. Скопируйте его в .env и заполните.
# .env хранит секреты: никому его не отправляйте, в git он не попадает.

# Токен бота от @BotFather (выглядит как 1234567890:AAH...)
BOT_TOKEN=

# Ваш Telegram ID — только вам будут доступны служебные команды (/stats)
# и сообщения об ошибках. Узнать ID: напишите боту /id.
ADMIN_ID=

# Пароль базы данных. Придумывать не нужно: файл «Запустить бота.command»
# заполнит его случайным паролем сам.
POSTGRES_PASSWORD=

# Адрес сервера Telegram Bot API. Менять, только если стандартный недоступен с вашего сервера.
TELEGRAM_API_URL=https://api.telegram.org
# Необязательный прокси для связи с Telegram (например, socks5://user:pass@host:port).
TELEGRAM_PROXY=

# Часовой пояс новых пользователей по умолчанию
DEFAULT_TIMEZONE=Europe/Moscow
